# Environment variables the site reads. Copy to `.env` (or set them in your
# host's dashboard) and fill in. Every value here is a placeholder.
#
# Nothing in this repository contains a real secret. Anything below that looks
# like one is an example.

# --- Core Django -----------------------------------------------------------
# Required in production. The code falls back to a known dev-only placeholder
# if this is unset, so that a deploy which loses the variable still boots --
# never rely on that fallback for a real site.
SECRET_KEY=replace-me-with-a-long-random-string

# Defaults to True so a local `runserver` serves static and media files.
# Set False in production.
DEBUG=False

ALLOWED_HOSTS=example.com,www.example.com

# --- Databases -------------------------------------------------------------
# The pipeline app uses PostgreSQL in production. Left unset, it falls back to
# a local SQLite file, which is why a fresh checkout has no production data.
PIPELINE_DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Email -----------------------------------------------------------------
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=

# --- Third-party services --------------------------------------------------
# Antibody Registry (RRID lookups). Optional: lookups degrade gracefully.
SCICRUNCH_API_KEY=

# Zenodo deposits. ZENODO_BASE_URL can point at sandbox.zenodo.org for testing.
ZENODO_API_TOKEN=
ZENODO_BASE_URL=https://zenodo.org
ZENODO_COMMUNITY=

# reCAPTCHA. The site key is public and lives in settings; only the secret
# belongs here.
RECAPTCHA_SECRET_KEY=

# Academy AI tutor. Offline by default -- set AI_TUTOR_OFFLINE=False to enable.
ANTHROPIC_API_KEY=
AI_TUTOR_OFFLINE=True
ACADEMY_AI_MODEL=claude-haiku-4-5
ACADEMY_AI_DAILY_MESSAGE_CAP=40
ACADEMY_AI_MAX_TOKENS=1500
ACADEMY_AI_MAX_TOOL_ROUNDS=6

# --- Object storage (Cloudflare R2) ----------------------------------------
# Media lives in object storage, not in git. Leave USE_R2=False locally.
USE_R2=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=
R2_ATTACHMENTS_BUCKET=
R2_ATTACHMENT_URL_SECONDS=300

# --- Cache -----------------------------------------------------------------
# Optional. Without it the API rate limit is counted per process (see
# core.W003), which is fine as an abuse guard but not exact.
CACHE_URL=
REDIS_URL=

# --- Browser extension links ------------------------------------------------
EXTENSION_PAGE_PUBLIC=False
EXTENSION_CHROME_URL=
EXTENSION_FIREFOX_URL=
EXTENSION_EDGE_URL=
EXTENSION_XPI_VERSION=
