{
  "manifest_version": 3,
  "name": "Only Good Antibodies — validation at a glance",
  "short_name": "OGA",
  "version": "0.2.4",
  "description": "Highlights antibodies cited on a page and shows the knockout-controlled validation data for the application they were used in.",
  "homepage_url": "https://onlygoodantibodies.co.uk/extension/",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://onlygoodantibodies.co.uk/*"
  ],
  "optional_host_permissions": [
    "*://*/*",
    "https://*.abcam.com/*",
    "https://*.thermofisher.com/*",
    "https://*.invitrogen.com/*",
    "https://*.cellsignal.com/*",
    "https://*.ptglab.com/*",
    "https://*.proteintech-group.com/*",
    "https://*.bio-techne.com/*",
    "https://*.novusbio.com/*",
    "https://*.rndsystems.com/*",
    "https://*.genetex.com/*",
    "https://*.sigmaaldrich.com/*",
    "https://*.merckmillipore.com/*",
    "https://*.scbt.com/*",
    "https://*.biolegend.com/*",
    "https://*.abclonal.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@onlygoodantibodies.co.uk",
      "update_url": "https://onlygoodantibodies.co.uk/extension/updates.json",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_title": "Only Good Antibodies",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
